# Reference for CI, deploy tooling and xtask. Not loaded automatically by xtask.
# Supply values through your secure shell/CI environment; do not commit them.
# CI: API token is a GitHub environment secret; account ID is a variable.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# production GitHub environment secrets mapped to Worker secrets by ci.yml.
TICKETS_BOOTSTRAP_USERNAME=""
TICKETS_BOOTSTRAP_PASSWORD_HASH=""
TICKETS_GITHUB_WEBHOOK_SECRET=""
TICKETS_GITHUB_APP_STORE_KEY=""
TICKETS_GITHUB_APP_SETUP_STATE=""

# Agent skill / curl examples. Importer uses --url, not TICKETS_URL.
TICKETS_URL="http://localhost:8787"
TICKETS_TOKEN=""
# Importer GitHub auth; if unset it uses gh auth token.
GITHUB_TOKEN=""

# Optional local browser/check overrides; uncomment only as needed.
# CHROME_BIN="/path/to/chromium"
# TICKETS_CHROME="/path/to/chromium"
# TICKETS_DESIGN_URL="http://127.0.0.1:8086"
# TICKETS_SCREENSHOT_DIR="target/screenshots"
# TICKETS_BEFORE_ASSETS="/path/to/base/crates/web/dist"
# TICKETS_SKIP_BUILD="1"
# LINT_BASE_REF="origin/main"
